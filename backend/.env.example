PORT=4000
# Local development uses SQLite automatically. Set this only when Neon is ready:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional maximum connections per serverless function instance (default: 3)
# DATABASE_POOL_MAX=3
SQLITE_PATH=.data/vetnet.sqlite
# Comma-separated list of browser origins allowed to call the API. Include the
# veteran site AND the separate request app if that app runs in a browser
# (native clients aren't subject to CORS).
CORS_ORIGINS=http://localhost:3000
# Seed demo veterans only when the database is empty (1/0)
SEED_DEMO_DATA=1
# Reseeding is an explicit command, not a startup flag: `npm run db:reset`
# (or `npm run dev:fresh` to reseed then start). Starting the API never wipes
# the local database, so a veteran you sign up survives file saves and restarts.
MOCK_OTP_CODE=123456

# Demo housekeeping (default 5): minutes after which a booked ride is treated as
# finished, completing the booking and handing the availability block back to
# the driver, so a demo can keep matching the same people. Locking itself is
# unchanged -- a block is still claimed atomically while the ride is live.
# Set to 0 to hold blocks until a ride is actually completed or cancelled.
DEMO_SLOT_RELEASE_MINUTES=5
