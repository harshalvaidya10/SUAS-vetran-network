PORT=4000
# Local development uses SQLite automatically. Set this only when Neon is ready:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional maximum connections per serverless function instance (default: 3)
# DATABASE_POOL_MAX=3
SQLITE_PATH=.data/vetnet.sqlite
# Comma-separated list of browser origins allowed to call the API. Include the
# veteran site AND the separate request app if that app runs in a browser
# (native clients aren't subject to CORS).
CORS_ORIGINS=http://localhost:3000
# Seed demo veterans only when the database is empty (1/0)
SEED_DEMO_DATA=1
# Local demo only: clear SQLite and reseed whenever the API restarts.
RESET_DATABASE_ON_START=0
MOCK_OTP_CODE=123456

# Demo mode (default on): a booking does not consume the veteran's availability
# block, and a driver already booked at that hour can be matched again. Lets a
# live demo fire the same request repeatedly and keep getting a driver. It
# allows double-booking a real person -- set to 0 for anything but a demo.
DEMO_REUSABLE_SLOTS=1
