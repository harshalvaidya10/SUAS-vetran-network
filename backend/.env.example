PORT=4000
# Local development uses SQLite automatically. Set this only when Neon is ready:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional maximum connections per serverless function instance (default: 3)
# DATABASE_POOL_MAX=3
SQLITE_PATH=.data/vetnet.sqlite
# Comma-separated list of browser origins allowed to call the API. Include the
# veteran site AND the separate request app if that app runs in a browser
# (native clients aren't subject to CORS).
CORS_ORIGINS=http://localhost:3000
# Seed demo veterans only when the database is empty (1/0)
SEED_DEMO_DATA=1
# Reseeding is an explicit command, not a startup flag: `npm run db:reset`
# (or `npm run dev:fresh` to reseed then start). Starting the API never wipes
# the local database, so a veteran you sign up survives file saves and restarts.
# --- API auth ----------------------------------------------------------------
# Comma-separated tokens the machine-to-machine callers present as
# `Authorization: Bearer <token>`. Guards the demand side (/ride-requests,
# /service-requests). Leave empty to turn the check off, which is the local
# default. The veteran site runs in a browser and cannot hold a secret, so its
# writes are guarded by the veteran's own session instead.
# API_SERVICE_TOKENS=
# How long a veteran stays signed in after entering their code.
SESSION_TTL_HOURS=12

# --- Phone login (OTP) -------------------------------------------------------
# mock  = print the code to the log and always use MOCK_OTP_CODE (no account
#         needed; what local development and the tests use)
# twilio = send a real text via Twilio Programmable SMS
SMS_PROVIDER=mock
MOCK_OTP_CODE=123456
# Required only when SMS_PROVIDER=twilio. TWILIO_FROM_NUMBER must be E.164,
# e.g. +16195550142.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Code lifecycle. These apply to the mock transport too.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Codes are stored hashed with this. Set a real secret in any deployment.
# OTP_HASH_SECRET=

# Demo housekeeping (default 5): minutes after which a booked ride is treated as
# finished, completing the booking and handing the availability block back to
# the driver, so a demo can keep matching the same people. Locking itself is
# unchanged -- a block is still claimed atomically while the ride is live.
# Set to 0 to hold blocks until a ride is actually completed or cancelled.
DEMO_SLOT_RELEASE_MINUTES=5
